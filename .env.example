# --- Site access (HTTP Basic Auth) ---
# Read by netlify/edge-functions/auth.ts. Required in production, where you set
# them in Netlify UI → Site configuration → Environment variables.
# netlify dev also loads this file, so use a test password locally.
#
# Only the SHA-256 hash of the password is stored, never the password itself:
#   echo -n "your-password" | shasum -a 256
# (the -n matters: a trailing newline would change the hash).
# The gate fails closed with 503 if SITE_PASSWORD_HASH is missing or malformed.
SITE_AUTH_USER=admin
SITE_PASSWORD_HASH=

# --- One-time data migration (scripts/migrate.ts only) ---
# Never commit real values.

# Connection string for the production Netlify Database. Copy it from the Netlify UI
# (Database → connection details), or after the first deploy:
#   netlify database status --branch production --show-credentials --json
# (`netlify database connect --json` resolves to the local dev database, not production.)
NETLIFY_DB_URL=postgres://user:password@host:5432/dbname

# Site ID (Netlify UI: Site configuration → General → Site ID)
NETLIFY_SITE_ID=

# Blobs access token (Netlify UI: Data & Storage → Blobs → tokens)
NETLIFY_BLOBS_TOKEN=

# Path to the original Python repo (defaults to ../bike_view)
# OLD_REPO=/Users/you/Desktop/bike_view
